diff --git a/src/pipeline/import_local_name.h b/src/pipeline/import_local_name.h
new file mode 100644
index 0000000000000000000000000000000000000000..bb75d08cb1b26eb194722394bae7e98b245814da
--- /dev/null
+++ b/src/pipeline/import_local_name.h
@@ -0,0 +1,53 @@
+/*
+ * Read local_name from IMPORTS edge properties.
+ */
+#ifndef CBM_PIPELINE_IMPORT_LOCAL_NAME_H
+#define CBM_PIPELINE_IMPORT_LOCAL_NAME_H
+
+#include <yyjson/yyjson.h>
+
+#include <stdlib.h>
+#include <string.h>
+
+static inline char *cbm_import_local_name_copy(const char *text, size_t length) {
+    char *copy = (char *)malloc(length + 1);
+    if (copy) {
+        memcpy(copy, text, length);
+        copy[length] = '\0';
+    }
+    return copy;
+}
+
+/* Return the decoded local_name, or NULL when it is absent or empty.
+ * For stored rows with invalid JSON, return the text after the local_name marker
+ * and before the first quote, as the old readers did. The caller must free the
+ * result. */
+static inline char *cbm_import_local_name(const char *properties_json) {
+    if (!properties_json) {
+        return NULL;
+    }
+    yyjson_doc *document = yyjson_read(properties_json, strlen(properties_json), 0);
+    if (document) {
+        yyjson_val *value = yyjson_obj_get(yyjson_doc_get_root(document), "local_name");
+        const char *text = yyjson_get_str(value);
+        char *name = NULL;
+        if (text && text[0]) {
+            name = cbm_import_local_name_copy(text, strlen(text));
+        }
+        yyjson_doc_free(document);
+        return name;
+    }
+    static const char marker[] = "\"local_name\":\"";
+    const char *start = strstr(properties_json, marker);
+    if (!start) {
+        return NULL;
+    }
+    start += sizeof(marker) - 1;
+    const char *end = strchr(start, '"');
+    if (!end || end <= start) {
+        return NULL;
+    }
+    return cbm_import_local_name_copy(start, (size_t)(end - start));
+}
+
+#endif /* CBM_PIPELINE_IMPORT_LOCAL_NAME_H */
