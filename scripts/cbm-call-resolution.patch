new file mode 100644
index 0000000000000000000000000000000000000000..ec40478f839a2123f05645d24698c1e64e1f333d
--- /dev/null
+++ b/src/store/adr_sidecar.h
@@ -0,0 +1,176 @@
+/*
+ * Store the project's architecture decision record in a file beside its graph
+ * database.
+ */
+#ifndef CBM_STORE_ADR_SIDECAR_H
+#define CBM_STORE_ADR_SIDECAR_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#ifndef _WIN32
+#include <unistd.h>
+#endif
+
+#define CBM_ADR_SIDECAR_SUFFIX ".adr"
+#define CBM_ADR_SIDECAR_TEMP_SUFFIX ".adr.tmp"
+#define CBM_ADR_SIDECAR_PATH_SIZE 4096
+#define CBM_DB_BACKUP_NAME_LIMIT 1000
+
+/* Return the sidecar content, or NULL if the file is empty or cannot be read.
+ * The caller must free the result. */
+static inline char *cbm_adr_sidecar_read(const char *db_path) {
+    char path[CBM_ADR_SIDECAR_PATH_SIZE];
+    int written = snprintf(path, sizeof(path), "%s%s", db_path, CBM_ADR_SIDECAR_SUFFIX);
+    if (written < 0 || (size_t)written >= sizeof(path)) {
+        return NULL;
+    }
+    struct stat info;
+    if (stat(path, &info) != 0 || !S_ISREG(info.st_mode) || info.st_size <= 0) {
+        return NULL;
+    }
+    FILE *file = fopen(path, "rb");
+    if (!file) {
+        return NULL;
+    }
+    size_t size = (size_t)info.st_size;
+    char *content = (char *)malloc(size + 1);
+    if (content) {
+        size_t count = fread(content, 1, size, file);
+        if (count == size) {
+            content[count] = '\0';
+        } else {
+            free(content);
+            content = NULL;
+        }
+    }
+    (void)fclose(file);
+    return content;
+}
+
+/* Flush the directory entry after a rename. */
+static inline int cbm_adr_sidecar_sync_directory(const char *db_path) {
+#ifdef _WIN32
+    (void)db_path;
+    return 0;
+#else
+    char directory[CBM_ADR_SIDECAR_PATH_SIZE];
+    int written = snprintf(directory, sizeof(directory), "%s", db_path);
+    if (written < 0 || (size_t)written >= sizeof(directory)) {
+        return -1;
+    }
+    char *separator = strrchr(directory, '/');
+    if (!separator) {
+        (void)snprintf(directory, sizeof(directory), ".");
+    } else if (separator == directory) {
+        directory[1] = '\0';
+    } else {
+        *separator = '\0';
+    }
+    int descriptor = open(directory, O_RDONLY);
+    if (descriptor < 0) {
+        return -1;
+    }
+    int result = fsync(descriptor);
+    (void)close(descriptor);
+    return result;
+#endif
+}
+
+/* Write and flush a temporary file, then rename it to replace the sidecar.
+ * Skip the write if the content matches. Return 0 on success or -1 on failure. */
+static inline int cbm_adr_sidecar_write(const char *db_path, const char *content) {
+    char *current = cbm_adr_sidecar_read(db_path);
+    if (current) {
+        int unchanged = strcmp(current, content) == 0;
+        free(current);
+        if (unchanged) {
+            return 0;
+        }
+    }
+    char path[CBM_ADR_SIDECAR_PATH_SIZE];
+    char temp_path[CBM_ADR_SIDECAR_PATH_SIZE];
+    int path_size = snprintf(path, sizeof(path), "%s%s", db_path, CBM_ADR_SIDECAR_SUFFIX);
+    int temp_size =
+        snprintf(temp_path, sizeof(temp_path), "%s%s", db_path, CBM_ADR_SIDECAR_TEMP_SUFFIX);
+    if (path_size < 0 || (size_t)path_size >= sizeof(path) || temp_size < 0 ||
+        (size_t)temp_size >= sizeof(temp_path)) {
+        return -1;
+    }
+    FILE *file = fopen(temp_path, "wb");
+    if (!file) {
+        return -1;
+    }
+    size_t length = strlen(content);
+    int failed = fwrite(content, 1, length, file) != length || fflush(file) != 0;
+#ifndef _WIN32
+    if (!failed) {
+        failed = fsync(fileno(file)) != 0;
+    }
+#endif
+    if (fclose(file) != 0) {
+        failed = 1;
+    }
+    if (failed || rename(temp_path, path) != 0) {
+        (void)remove(temp_path);
+        return -1;
+    }
+    return cbm_adr_sidecar_sync_directory(db_path);
+}
+
+/* cbm_db_backup_unreadable backs up an unreadable database and its WAL file, if present.
+ * It tries <database path>.corrupt first, then numbered names through .corrupt.999.
+ * link does not replace an existing database backup. The database and WAL file can contain
+ * an architecture decision record that the sidecar file lacks. Close the engine's database
+ * connections before calling this function. It returns 0 on success or -1 on failure.
+ * A failed backup does not delete the original database path. */
+static inline int cbm_db_backup_unreadable(const char *db_path) {
+#ifdef _WIN32
+    (void)db_path;
+    return -1;
+#else
+    char backup_path[CBM_ADR_SIDECAR_PATH_SIZE];
+    char wal_path[CBM_ADR_SIDECAR_PATH_SIZE];
+    char backup_wal_path[CBM_ADR_SIDECAR_PATH_SIZE];
+    int wal_size = snprintf(wal_path, sizeof(wal_path), "%s-wal", db_path);
+    if (wal_size < 0 || (size_t)wal_size >= sizeof(wal_path)) {
+        return -1;
+    }
+    for (int attempt = 0; attempt < CBM_DB_BACKUP_NAME_LIMIT; attempt++) {
+        int written = attempt == 0
+                          ? snprintf(backup_path, sizeof(backup_path), "%s.corrupt", db_path)
+                          : snprintf(backup_path, sizeof(backup_path), "%s.corrupt.%d", db_path,
+                                     attempt);
+        int backup_wal_size = snprintf(backup_wal_path, sizeof(backup_wal_path), "%s-wal", backup_path);
+        if (written < 0 || (size_t)written >= sizeof(backup_path) || backup_wal_size < 0 ||
+            (size_t)backup_wal_size >= sizeof(backup_wal_path)) {
+            return -1;
+        }
+        if (link(db_path, backup_path) != 0) {
+            if (errno == EEXIST) {
+                continue;
+            }
+            return -1;
+        }
+        int wal_moved = rename(wal_path, backup_wal_path) == 0;
+        if (!wal_moved && errno != ENOENT) {
+            (void)unlink(backup_path);
+            return -1;
+        }
+        if (unlink(db_path) != 0) {
+            if (wal_moved && rename(backup_wal_path, wal_path) != 0) {
+                return -1;
+            }
+            (void)unlink(backup_path);
+            return -1;
+        }
+        return 0;
+    }
+    return -1;
+#endif
+}
+
+#endif /* CBM_STORE_ADR_SIDECAR_H */
